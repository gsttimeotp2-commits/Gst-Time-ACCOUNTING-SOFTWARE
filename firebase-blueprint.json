{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User business profile, company details, GSTIN, bank details, and settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "businessName": { "type": "string", "maxLength": 200 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 20 },
        "gstin": { "type": "string", "maxLength": 20 },
        "address": { "type": "string", "maxLength": 500 },
        "state": { "type": "string", "maxLength": 50 },
        "bankName": { "type": "string", "maxLength": 100 },
        "accountNumber": { "type": "string", "maxLength": 50 },
        "ifsc": { "type": "string", "maxLength": 20 },
        "upiId": { "type": "string", "maxLength": 100 },
        "invoiceTerms": { "type": "string", "maxLength": 1000 },
        "defaultTemplate": { "type": "string", "enum": ["modern", "classic", "compact"] },
        "role": { "type": "string", "enum": ["owner", "cashier", "accountant"] },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "businessName"]
    },
    "Party": {
      "title": "Party",
      "description": "Customer or supplier record for ledger and invoices",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["customer", "supplier"] },
        "name": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 20 },
        "email": { "type": "string", "maxLength": 150 },
        "gstin": { "type": "string", "maxLength": 20 },
        "billingAddress": { "type": "string", "maxLength": 500 },
        "state": { "type": "string", "maxLength": 50 },
        "openingBalance": { "type": "number" },
        "currentBalance": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "type", "name"]
    },
    "Item": {
      "title": "Item",
      "description": "Product or service item in inventory",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "sku": { "type": "string", "maxLength": 50 },
        "hsn": { "type": "string", "maxLength": 20 },
        "unit": { "type": "string", "maxLength": 20 },
        "salePrice": { "type": "number" },
        "purchasePrice": { "type": "number" },
        "stock": { "type": "number" },
        "minStockAlert": { "type": "number" },
        "taxRate": { "type": "number" },
        "category": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "name", "salePrice"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Sales invoice, purchase bill, or return voucher",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["sale", "purchase", "sale_return", "purchase_return"] },
        "invoiceNumber": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 50 },
        "partyId": { "type": "string", "maxLength": 128 },
        "partyName": { "type": "string", "maxLength": 150 },
        "partyPhone": { "type": "string", "maxLength": 20 },
        "partyGstin": { "type": "string", "maxLength": 20 },
        "partyAddress": { "type": "string", "maxLength": 500 },
        "isInterState": { "type": "boolean" },
        "subtotal": { "type": "number" },
        "taxTotal": { "type": "number" },
        "cgst": { "type": "number" },
        "sgst": { "type": "number" },
        "igst": { "type": "number" },
        "discount": { "type": "number" },
        "grandTotal": { "type": "number" },
        "paidAmount": { "type": "number" },
        "balanceAmount": { "type": "number" },
        "paymentMode": { "type": "string", "maxLength": 50 },
        "paymentStatus": { "type": "string", "enum": ["paid", "partial", "unpaid"] },
        "notes": { "type": "string", "maxLength": 1000 },
        "template": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "type", "invoiceNumber", "grandTotal"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Operating expense or overhead entry",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "amount": { "type": "number" },
        "date": { "type": "string", "maxLength": 50 },
        "paymentMode": { "type": "string", "maxLength": 50 },
        "taxDeductible": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "category", "amount", "title"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment receipt or payment-out record",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["in", "out"] },
        "partyId": { "type": "string", "maxLength": 128 },
        "partyName": { "type": "string", "maxLength": 150 },
        "amount": { "type": "number" },
        "date": { "type": "string", "maxLength": 50 },
        "paymentMode": { "type": "string", "maxLength": 50 },
        "referenceNo": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "type", "partyName", "amount"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Recurring invoice and client subscription schedule",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "clientPartyId": { "type": "string", "maxLength": 128 },
        "clientName": { "type": "string", "maxLength": 150 },
        "clientPhone": { "type": "string", "maxLength": 20 },
        "clientEmail": { "type": "string", "maxLength": 150 },
        "frequency": { "type": "string", "enum": ["weekly", "monthly", "quarterly", "yearly"] },
        "startDate": { "type": "string", "maxLength": 50 },
        "nextBillingDate": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["active", "paused", "completed", "cancelled"] },
        "subtotal": { "type": "number" },
        "taxTotal": { "type": "number" },
        "grandTotal": { "type": "number" },
        "autoGenerate": { "type": "boolean" },
        "generatedCount": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "clientName", "frequency", "nextBillingDate", "grandTotal"]
    }
  },
  "firestore": {
    "/users/{userId}/profile": {
      "schema": { "$ref": "UserProfile" },
      "description": "Business profile and configuration for the user"
    },
    "/users/{userId}/parties/{partyId}": {
      "schema": { "$ref": "Party" },
      "description": "Customers and suppliers of the user"
    },
    "/users/{userId}/items/{itemId}": {
      "schema": { "$ref": "Item" },
      "description": "Inventory product items for the user"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "Transaction" },
      "description": "Sales, purchases, and returns invoices"
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": { "$ref": "Expense" },
      "description": "Business expense entries"
    },
    "/users/{userId}/payments/{paymentId}": {
      "schema": { "$ref": "Payment" },
      "description": "Payments in and out records"
    },
    "/users/{userId}/subscriptions/{subscriptionId}": {
      "schema": { "$ref": "Subscription" },
      "description": "Automated recurring billing schedules and subscriptions"
    }
  }
}
